# 使用 Node.js 24.7.0 slim 作为基础镜像
FROM node:24.7.0-slim

# 安装 Chromium 运行依赖和中文字体
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium \
    chromium-sandbox \
    fonts-liberation \
    fonts-wqy-zenhei \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    wget \
    xdg-utils && \
    rm -rf /var/lib/apt/lists/*

# 设置环境变量
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    TZ=Asia/Shanghai \
    NODE_ENV=production \
    HEADLESS=true

# 创建非 root 用户
RUN groupadd -r nodejs && useradd -r -g nodejs -m -d /home/nodejs nodejs

# 创建工作目录
WORKDIR /app

# 复制依赖文件
COPY package-clawcloud.json package.json

# 安装依赖（仅生产依赖）
RUN npm install --only=production

# 复制源代码
COPY update-clawcloud-token.js ./

# 设置文件权限
RUN chown -R nodejs:nodejs /app

# 切换到非 root 用户（已禁用，使用 root 用户解决挂载权限问题）
# USER nodejs

# 健康检查（可选）
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "console.log('Healthy')" || exit 1

# 启动脚本
CMD ["node", "update-clawcloud-token.js"]