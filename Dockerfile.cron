# 使用 Ubuntu 22.04
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    LC_ALL=zh_CN.UTF-8

# 安装基础工具、桌面环境、Chrome、xvfb、VNC、中文支持、五笔输入法
RUN apt-get update && apt-get install -y \
    wget curl gnupg ca-certificates \
    fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 \
    libc6 libcairo2 libcups2 libdbus-1-3 libexpat1 libfontconfig1 \
    libgbm1 libgcc1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 \
    libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 \
    libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 \
    libxdamage1 libxext6 libxfixes3 libxi6 libxrandr2 libxrender1 \
    libxss1 libxtst6 lsb-release xdg-utils \
    xvfb fonts-wqy-zenhei \
    xfce4 xfce4-terminal dbus-x11 sudo git unzip nano \
    net-tools \
    x11vnc \
    fcitx \
    fcitx-table-wbpy \
    fcitx-frontend-gtk2 \
    fcitx-frontend-gtk3 \
    fcitx-frontend-qt5 \
    fcitx-config-gtk \
    fcitx-ui-classic \
    locales \
    iso-codes \
    adwaita-icon-theme \
    gnome-icon-theme \
    elementary-xfce-icon-theme \
    gtk2-engines-pixbuf \
    libgtk2.0-0 \
    libgtk-3-0 \
    --no-install-recommends \
    && locale-gen zh_CN.UTF-8 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*


# 安装 Chrome（最新稳定版）
RUN wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable --no-install-recommends \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 设置 Chrome 快捷方式添加 --no-sandbox 和输入法支持
RUN sed -i 's/Exec=\/usr\/bin\/google-chrome-stable/Exec=\/usr\/bin\/google-chrome-stable --no-sandbox --enable-wayland-ime --force-device-scale-factor=1 --disable-gpu --disable-webgl/' /usr/share/applications/google-chrome.desktop

# 安装 Node.js 24
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 安装 noVNC
RUN git clone https://github.com/novnc/noVNC.git /opt/novnc \
    && git clone https://github.com/novnc/websockify /opt/novnc/utils/websockify

# 将用户主目录重定向到持久化挂载点
ENV HOME=/app/puppeteer_user_data

# 预配置 Fcitx 输入法（直接写入默认配置文件，删除 Unknown）
RUN mkdir -p /etc/skel/.config/fcitx && \
    echo "[Profile]\nIMName=五笔拼音\nEnabledIMList=fcitx-keyboard-en-us:True,wbpy:True" > /etc/skel/.config/fcitx/profile && \
    mkdir -p /etc/skel/.config/autostart && \
    cp /usr/share/applications/fcitx.desktop /etc/skel/.config/autostart/

# 全局环境变量文件，确保所有图形应用都能加载 fcitx
RUN echo 'export GTK_IM_MODULE=fcitx' > /etc/profile.d/fcitx.sh && \
    echo 'export QT_IM_MODULE=fcitx' >> /etc/profile.d/fcitx.sh && \
    echo 'export XMODIFIERS=@im=fcitx' >> /etc/profile.d/fcitx.sh && \
    echo 'export DEFAULT_IM=fcitx' >> /etc/profile.d/fcitx.sh && \
    chmod +x /etc/profile.d/fcitx.sh

WORKDIR /app

# 复制爬虫相关文件
COPY package-cron.json ./package.json
RUN npm install

COPY scripts/quick-plan-update-new.js \
     scripts/update-pdd.js \
     scripts/update-pdd-new.js \
     scripts/update-pdd-cron.js \
     scripts/update-clawcloud-token.js \
     scripts/clean-browser-profiles.js \
     scripts/quick-plan-update.js \
     scripts/quick-update-bill.js \
     scripts/trigger-server.js \
     scripts/proxy.js \
     ./scripts/
RUN chmod +x /app/scripts/trigger-server.js /app/scripts/proxy.js

# 复制启动脚本
COPY start-cron.sh /start.sh
RUN chmod +x /start.sh

# 暴露端口
EXPOSE 6080 5900 3000

CMD ["/start.sh"]
